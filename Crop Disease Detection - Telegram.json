        320
      ],
      "id": "83cf88d0-d1df-4eb3-a5f1-9906ce68c97f"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { reply_text: `❌ Sorry, something went wrong while analyzing your photo. Please try again in a moment.` } }];"
      },
      "name": "Format Error Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,

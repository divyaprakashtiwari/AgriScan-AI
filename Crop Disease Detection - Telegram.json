    {
      "parameters": {
        "jsCode": "const rawDisease = $json.disease;\nconst diseaseHindi = $json.disease_hindi;\nconst confidence = ($json.confidence * 100).toFixed(1);\n\n// Clean up disease name: remove underscores, extra spaces\nconst cleanDisease = rawDisease\n  .replace(/_+/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst replyText =\n`🌱 *Crop Disease Diagnosis*\n\n🔍 Disease: ${cleanDisease}\n🌿 रोग: ${diseaseHindi}\n📊 Confidence: ${confidence}%\n\n💊 Please check the treatment guide for this condition.`;\n\nreturn [{ json: { reply_text: replyText } }];"
      },
      "name": "Format Success Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        240,
        128
      ],
      "id": "23944683-ed89-42ba-b682-1f93a833c89c"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { reply_text: `⚠️ I'm not confident about this diagnosis. Please retake the photo with better lighting, closer to the leaf, and try again.` } }];"
      },
      "name": "Format Low Confidence Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
